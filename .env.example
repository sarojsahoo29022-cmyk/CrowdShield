# Copy this file to .env.local and fill in values from
# Supabase → your project → Settings → API.
#
# Phase 2 uses these to confirm the database is reachable.
# Phase 3 will make dashboard API routes read from Supabase.
# Until then, empty values keep the app on mock API data.

# Project URL. Safe to expose to the browser later if needed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key. Not used by the dashboard in Phase 2.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only database access. Never prefix this with NEXT_PUBLIC.
# Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
